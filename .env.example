APP_NAME="Inventory & Sales Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# MySQL (recommended)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_and_sales_management
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative (quick local dev — uncomment and comment out MySQL above)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ─── Session / Cache / Queue ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@inventory-system.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── File Storage ────────────────────────────────────────────────────────────
# Product images are stored on the local public disk by default.
# Run: php artisan storage:link  (creates public/storage symlink)
# AWS S3 (optional — fill in if you switch FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Sanctum / Auth ──────────────────────────────────────────────────────────
# Add your frontend origin(s) so Sanctum accepts cookie-based requests
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,localhost:3002,127.0.0.1,127.0.0.1:8000,127.0.0.1:3000,127.0.0.1:3001,127.0.0.1:3002,::1

# ─── CORS ────────────────────────────────────────────────────────────────────
# Must match the port your React dev server runs on (default 3001 per frontend/.env)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# ─── Vite (not used by the React frontend — Laravel blade only) ──────────────
VITE_APP_NAME="${APP_NAME}"

# ─── AI Assistant (Mistral) ──────────────────────────────────────────────────
# Get your free key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
